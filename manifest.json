{
  "manifest_version": 3,
  "name": "Thread Post Counter",
  "version": "1.0.0",
  "description": "Shows how many posts you have in the current forum thread",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*.mafiauniverse.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.mafiauniverse.com/forums/threads/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
